# Anthropic (Claude) — required to run the agent
ANTHROPIC_API_KEY=sk-ant-...

# LangSmith — required for tracing, observability, and running the eval suite
# (LangSmith's "agent-based workspace" model: traces are addressed by an
# agent id + environment, not an older project name)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_AGENT_ID=stock-analyst-chat
LANGSMITH_AGENT_ENVIRONMENT=local

# Alpaca Markets — free paper-trading account gives a key with market data
# access, used only to independently cross-check prices against yfinance.
# Sign up at https://alpaca.markets (no funding required for data access).
ALPACA_API_KEY=...
ALPACA_SECRET_KEY=...

# Optional: pick a specific Claude model (defaults to claude-sonnet-4-5-20250929)
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
